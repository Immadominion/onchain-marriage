{
 "compilerOptions": {
  "target": "ES2020",
  "module": "commonjs",
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,
  "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src"]
}
